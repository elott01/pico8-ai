# Server-side only. Do NOT prefix with VITE_ — any VITE_-prefixed var is inlined
# into the browser bundle and would leak the key.
#
# Copy this file to .env.local and paste a real key from Google AI Studio.
# Without a key set, /api/move falls back to a hardcoded legal move so the loop
# still runs end to end under `vercel dev`.
GEMINI_API_KEY=
