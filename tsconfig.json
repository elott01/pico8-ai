{
  // Types are never emitted by tsc: Vite (esbuild) compiles src/, and Node 24 strips
  // types from tests/ natively. This config exists purely to typecheck both.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Both compilers strip types per-file, without cross-file knowledge, so the source
    // has to stay unambiguous on its own.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Rejects syntax Node cannot strip (enum, namespace, parameter properties). Without
    // this, `npm test` breaks at runtime on code that typechecks fine.
    "erasableSyntaxOnly": true,

    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Imports carry explicit .ts/.tsx extensions so Node can resolve them when it strips
    // types for `npm test`. Vercel's function builder *emits* .js files, though, and
    // TypeScript never rewrites specifiers on its own — a `.ts` specifier would survive
    // compilation and fail to resolve at runtime. rewriteRelativeImportExtensions turns
    // them into .js on emit, so both runtimes resolve. Removing either flag breaks one.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Kept on so a stray .js file (or a .js import specifier) still resolves; nothing in
    // src/, api/ or tests/ is JavaScript any more.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "tests", "api", "bench", "env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
